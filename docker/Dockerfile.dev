# Minimal Dockerfile (dev) - copia el repo y ejecuta ./scripts/setup.sh durante el build
FROM ubuntu:22.04

# 1) paquetes mínimos necesarios para que ./scripts/setup.sh funcione

# Fixed tool versions (CTO decision):
ENV NOIR_VERSION=1.0.0-beta.1
ENV BB_VERSION=0.67.0
ENV GARAGA_VERSION=0.15.5
ENV SCARB_VERSION=2.9.2

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget git sudo ca-certificates python3.10 python3.10-dev python3-pip \
    build-essential tar gzip unzip pkg-config gnupg lsb-release \
  && rm -rf /var/lib/apt/lists/*

# Install Node.js 22 because some packages require Node >=22 (starknet, vite)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*

# Install Bun (optional, used in package.json scripts). Install into /root/.bun and symlink.
RUN curl -fsSL https://bun.sh/install | bash -s -- --no-sudo --prefix /usr/local || true \
  && if [ -f /usr/local/bin/bun ]; then chmod +x /usr/local/bin/bun || true; fi

# 3) copiar el repositorio al contenedor
WORKDIR /workspace
COPY . /workspace

# 4) ejecutar el setup script durante el build como root (más simple)
#    el script pedirá confirmación; enviamos un salto de línea para aceptar
ENV SHELL=/bin/bash
RUN printf '\n' | NOIR_VERSION=${NOIR_VERSION} BB_VERSION=${BB_VERSION} SCARB_VERSION=${SCARB_VERSION} GARAGA_VERSION=${GARAGA_VERSION} bash ./scripts/setup.sh

# 5) defaults para desarrollo
ENV CHOKIDAR_USEPOLLING=true
EXPOSE 3000
WORKDIR /workspace
ENTRYPOINT ["bash"]
